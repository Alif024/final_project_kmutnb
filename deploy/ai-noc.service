# แม่แบบ systemd unit ของ AI-NOC — คัดลอกไปที่ /etc/systemd/system/ai-noc.service
# แล้วแก้ User/Group/Path ให้ตรงกับเครื่องจริง (ดูขั้นตอนเต็มใน deploy/README.md)
[Unit]
Description=AI-NOC dashboard (Next.js standalone)
Documentation=https://github.com/Alif024/final_project_kmutnb
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ต้องเป็นผู้ใช้ที่อ่านไฟล์ใน /opt/ai-noc ได้ (ง่ายสุดคือผู้ใช้เดียวกับที่รัน GitHub Runner)
User=ainoc
Group=ainoc

# ชี้ไปที่ Symlink — workflow สลับ Symlink ก่อนแล้วค่อยสั่ง restart
# systemd อ่านค่าปลายทางของ Symlink ตอนเริ่มโปรเซส เวอร์ชันใหม่จึงมีผลทันทีที่ restart
WorkingDirectory=/opt/ai-noc/current
ExecStart=/usr/bin/node server.js

# ไฟล์ค่าลับของเครื่อง — ขีดหน้า path แปลว่า "ไม่มีไฟล์นี้ก็สตาร์ตได้"
# ตอนนี้ระบบใช้ข้อมูลจำลอง จึงยังไม่จำเป็นต้องมี ใส่เฉพาะ GEMINI_API_KEY ก็พอ
# ตัวแปรของ Zabbix/vCenter/Proxmox ค่อยเติมทีหลังได้ (ดู .env.example)
# เก็บไว้นอกโฟลเดอร์ Release เพื่อไม่ให้ถูกทับตอน Deploy
EnvironmentFile=-/etc/ai-noc/ai-noc.env
Environment=NODE_ENV=production
Environment=PORT=3000
# ผูกกับ 127.0.0.1 เมื่อมี Reverse Proxy (Nginx/Caddy) อยู่หน้า — ถ้าเปิดตรงให้ใช้ 0.0.0.0
Environment=HOSTNAME=127.0.0.1

Restart=always
RestartSec=3
# ถ้าโปรเซสไม่ยอมจบเอง systemd จะรอถึง 90 วินาทีตามค่าเริ่มต้นก่อนบังคับปิด
# ซึ่งทำให้ `systemctl restart` ใน workflow ค้างนานเกินจำเป็น — ตัดเหลือ 20 วินาที
TimeoutStopSec=20

# ความปลอดภัยพื้นฐาน — ProtectHome=true ทำให้อ่าน /home ไม่ได้
# จึงต้องวางแอปไว้ที่ /opt หรือ /srv เท่านั้น
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
